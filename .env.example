# Local development values only. Replace the JWT secret and passwords before use.
SPRING_DATASOURCE_USERNAME=cloudstorage
SPRING_DATASOURCE_PASSWORD=change-me-local-only

# Generate a private value with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_base64_48
JWT_EXPIRATION_MS=86400000

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-local-only
MINIO_BUCKET_NAME=cloudstorage

MAX_UPLOAD_SIZE_BYTES=104857600
MAX_REQUEST_SIZE_BYTES=524288000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
